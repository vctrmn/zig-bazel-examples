"""
This module sets up a Zap backend project with Bazel and Zig.
"""

module(
    name = "base32_example",
    version = "0.0.0",
)

# https://github.com/aherrmann/rules_zig/releases
bazel_dep(name = "rules_zig", version = "0.6.0")
bazel_dep(name = "platforms", version = "0.0.10")

# Zig toolchain
ZIG_VERSION = "0.13.0"
zig = use_extension("@rules_zig//zig:extensions.bzl", "zig")
zig.toolchain(zig_version = ZIG_VERSION)

# Base32 library # base32 = use_extension("//:third_party/base32/extensions.bzl", "base32")
base32 = use_extension("//third_party/base32:extensions.bzl", "base32")
use_repo(base32, "base32")

# ZLS language server
zls_archive = use_extension("//third_party/zls:extensions.bzl", "zls_archive")
use_repo(zls_archive, "zls_aarch64-macos", "zls_x86_64-macos", "zls_x86_64-linux")
